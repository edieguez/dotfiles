# ==============================================================================
# Ghostty & Tmux Integration Configuration (Prefix: Ctrl+B, \x02)
# ==============================================================================

# Every OS window attaches to session "main" or joins its group (own view of
# the same windows). The script sits next to this file.
command = /bin/zsh -l -c "$HOME/.config/ghostty/tmux-main"

# ------------------------------------------------------------------------------
# Quit (Cmd + Q)
# ------------------------------------------------------------------------------
# Cmd+Q is Ghostty's own quit. Each tmux client gets a hangup and detaches;
# the server and session "main" survive, and the next launch reattaches.
# Do not ask "process still running?" on close: tmux always is.
confirm-close-surface = false

# ------------------------------------------------------------------------------
# Window Navigation
# ------------------------------------------------------------------------------
# Ctrl + 1..9: Go to window N (Cmd + digit is taken by Ghostty's own tab switching)
keybind = ctrl+1=text:\x021
keybind = ctrl+2=text:\x022
keybind = ctrl+3=text:\x023
keybind = ctrl+4=text:\x024
keybind = ctrl+5=text:\x025
keybind = ctrl+6=text:\x026
keybind = ctrl+7=text:\x027
keybind = ctrl+8=text:\x028
keybind = ctrl+9=text:\x029

# Cmd + [ / ]: Previous / next window (prefix + C-h / C-l; Oh my Tmux uses p for paste)
keybind = super+[=text:\x02\x08
keybind = super+]=text:\x02\x0c

# Ctrl + Tab: Last window (prefix + Tab)
keybind = ctrl+tab=text:\x02\x09

# Cmd + Shift + Left / Right: Move current window left / right (prefix + { / })
keybind = super+shift+left=text:\x02{
keybind = super+shift+right=text:\x02}

# ------------------------------------------------------------------------------
# Window Creation & Renaming (Cmd)
# ------------------------------------------------------------------------------
# Cmd + T: Create new Tmux window (prefix + c)
keybind = super+t=text:\x02c

# Cmd + Shift + R: Rename current Tmux window (prefix + ,)
keybind = super+shift+r=text:\x02,

# ------------------------------------------------------------------------------
# Splits & Pane Controls (Cmd)
# ------------------------------------------------------------------------------
# Cmd + D: Vertical split (prefix + ")
keybind = super+d=text:\x02"

# Cmd + Shift + D: Horizontal split (prefix + %)
keybind = super+shift+d=text:\x02%

# Cmd + Shift + Enter: Toggle Pane Zoom / Fullscreen (prefix + z)
keybind = super+shift+enter=text:\x02z

# Cmd + W: Close current pane (prefix + x)
keybind = super+w=text:\x02x

# Cmd + K: Clear screen and scrollback of the current pane (prefix + C-k)
keybind = super+k=text:\x02\x0b

# Cmd + F: Search the scrollback (copy mode + backward search)
keybind = super+f=text:\x02[?

# ------------------------------------------------------------------------------
# Session Switcher (Cmd)
# ------------------------------------------------------------------------------
# Cmd + Shift + O: Open interactive Tmux session switcher (prefix + s)
keybind = super+shift+o=text:\x02s

# Cmd + Shift + N: New session in the current directory (prefix + C-c)
keybind = super+shift+n=text:\x02\x03

theme = Pure Black Vivid
mouse-hide-while-typing = true
custom-shader = ~/.config/ghostty/shaders/cursor-smear.glsl
macos-option-as-alt = right

# brew install --cask font-jetbrains-mono
font-family = "JetBrains Mono"
font-size = 12.5

window-padding-balance = true
font-thicken = true
adjust-cell-height = 6%
